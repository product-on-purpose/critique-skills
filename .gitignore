# Local-only working notes and plans. Never committed.
_local/
_LOCAL/

# Agent working context kept out of the public repo (session logs live here).
# docs/internal/ is the tracked "public internal" folder; this is the private one.
_agent-context/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Tooling
node_modules/
npm-debug.log*
__pycache__/
*.pyc

# claude-mem / memsearch local observation store (immutable session record, not source)
.memsearch/

# The conformance gate clones the toolkit validators here (CI) or expects a sibling checkout;
# see scripts/lib/resolve-toolkit.mjs.
.agent-skills-toolkit/

# Playwright MCP scratch (screenshots, snapshots, console logs from local testing)
.playwright-mcp/

# Claude Code local agent state (worktrees, local settings) - never committed.
.claude/

# CI-time artifact of scripts/extract-release-notes.mjs (writes the release body that
# release.yml passes to the GitHub Release step); never a source file, never committed.
RELEASE_BODY.md

# Crash debris from the Git-for-Windows bash shim; appears when a piped command is killed.
*.stackdump
